"""
ComposeWithLLM - FL Studio Piano Roll Script for MCP Integration

This script enables AI assistants to control FL Studio's piano roll by:
1. Reading note requests from mcp_request.json
2. Adding/deleting/clearing notes in the piano roll
3. Exporting the current state to piano_roll_state.json

Trigger: Cmd+Opt+Y (macOS) or Ctrl+Alt+Y (Windows)

Based on work from https://github.com/calvinw/fl-studio-mcp
"""

import flpianoroll as flp
import json
import os


def get_script_dir():
    """Get the directory where this script is located"""
    return os.path.expanduser("~/Documents/Image-Line/FL Studio/Settings/Piano roll scripts")


REQUEST_FILE = os.path.join(get_script_dir(), "mcp_request.json")
RESPONSE_FILE = os.path.join(get_script_dir(), "mcp_response.json")
STATE_FILE = os.path.join(get_script_dir(), "piano_roll_state.json")

# Bumped when the request/response format changes; the MCP server checks it.
SCRIPT_VERSION = 2
# Optional note properties sent by the MCP server (server-validated).
NOTE_PROPERTIES = ("pan", "color", "slide", "porta")


def _apply_note_properties(midi_note, note_data):
    for prop in NOTE_PROPERTIES:
        if prop in note_data:
            setattr(midi_note, prop, note_data[prop])


def write_json(path, data):
    """Write JSON in a single call.

    A temp-file + os.replace() approach is NOT possible here: FL's embedded
    interpreter raises SystemError from os.replace (verified with FL 2026).
    Serialising first and writing once keeps the window in which the MCP
    server could read a half-written file as small as possible; the server
    re-reads a file that does not parse yet.
    """
    text = json.dumps(data, indent=2)
    with open(path, 'w') as f:
        f.write(text)


def export_piano_roll_state():
    """Export current piano roll state to JSON file"""
    notes_data = []
    ppq = flp.score.PPQ

    # Collect all notes
    for i in range(flp.score.noteCount):
        note = flp.score.getNote(i)
        notes_data.append({
            "number": note.number,
            "midi": note.number,  # Alias for convenience
            "time": note.time / ppq if ppq > 0 else 0,  # Convert to quarter notes
            "time_ticks": note.time,
            "duration": note.length / ppq if ppq > 0 else 0,  # Convert to quarter notes
            "length_ticks": note.length,
            "velocity": note.velocity,
            "pan": note.pan,
            "color": note.color,
            "fcut": note.fcut,
            "fres": note.fres,
            "slide": note.slide,
            "porta": note.porta,
            "pitchofs": note.pitchofs,
            "selected": note.selected,
            "muted": note.muted,
        })

    # Export metadata
    export_data = {
        "ppq": ppq,
        "noteCount": flp.score.noteCount,
        "notes": notes_data
    }

    # Save to file
    write_json(STATE_FILE, export_data)

    return STATE_FILE


def get_piano_roll_context():
    """Report context of the currently open piano roll (read-only)."""
    context = {
        "ppq": flp.score.PPQ,
        "tsnum": flp.score.tsnum,
        "tsden": flp.score.tsden,
        "time_signature": "%d/%d" % (flp.score.tsnum, flp.score.tsden),
        "note_count": flp.score.noteCount,
        "marker_count": flp.score.markerCount,
        "snap_root_note": flp.score.snap_root_note,
        "snap_scale_helper": flp.score.snap_scale_helper,
        "timeline_selection": list(flp.score.getTimelineSelection()),
    }
    # The controller-scripting modules are usually importable from piano roll
    # scripts too; they let us report the selected channel / active pattern,
    # which flpianoroll itself does not expose.
    try:
        import channels
        idx = channels.selectedChannel()
        context["selected_channel"] = {
            "index": idx,
            "name": channels.getChannelName(idx),
        }
    except Exception as e:
        context["selected_channel_error"] = str(e)
    try:
        import patterns
        num = patterns.patternNumber()
        context["current_pattern"] = {
            "index": num,
            "name": patterns.getPatternName(num),
        }
    except Exception as e:
        context["current_pattern_error"] = str(e)
    return {"status": "success", "context": context}


def process_mcp_request():
    """Process every queued request; one failing request does not stop the others.

    FL has no transaction: what succeeded before a failure stays applied, and
    the counters report it.
    """
    if not os.path.exists(REQUEST_FILE):
        return None

    try:
        with open(REQUEST_FILE, 'r') as f:
            content = json.load(f)
    except Exception as e:
        return {"status": "error", "message": "could not read request file: %s" % e,
                "script_version": SCRIPT_VERSION, "note_count": flp.score.noteCount}

    # Handle both single request (old format) and list of requests (new format)
    if isinstance(content, list):
        requests = content
    elif isinstance(content, dict) and content.get("action"):
        requests = [content]
    else:
        return None
    if not requests:
        return None

    total_notes = 0
    notes_deleted = 0
    context_result = None
    failures = []
    handlers = {
        "add_notes": add_notes_to_piano_roll,
        "add_chord": add_chord_to_piano_roll,
        "delete_notes": delete_notes_from_piano_roll,
    }

    for position, request in enumerate(requests):
        action = request.get("action") if isinstance(request, dict) else None
        try:
            if action == "get_context":
                context_result = get_piano_roll_context()
            elif action == "clear":
                count = flp.score.noteCount
                for i in range(count - 1, -1, -1):
                    flp.score.deleteNote(i)
                notes_deleted += count
            elif action in handlers:
                result = handlers[action](request) or {}
                total_notes += result.get("notes_added", 0)
                notes_deleted += result.get("notes_deleted", 0)
                if result.get("status") != "success":
                    failures.append({"index": position, "action": action,
                                     "message": result.get("message", "unknown error")})
            else:
                failures.append({"index": position, "action": action,
                                 "message": "unknown action %r" % (action,)})
        except Exception as e:
            failures.append({"index": position, "action": action, "message": str(e)})

    # Clear the request queue after processing, even after a failure
    with open(REQUEST_FILE, 'w') as f:
        f.write("[]")

    summary = {
        "status": "error" if failures else "success",
        "requests_processed": len(requests),
        "notes_added": total_notes,
        "notes_deleted": notes_deleted,
        "script_version": SCRIPT_VERSION,
        "note_count": flp.score.noteCount,
    }
    if failures:
        first = failures[0]
        summary["message"] = "action %d (%s) failed: %s" % (
            first["index"], first["action"], first["message"])
        summary["failures"] = failures
    if context_result is not None:
        summary["context"] = context_result.get("context", context_result)
    return summary


def add_chord_to_piano_roll(request):
    """Add a chord's notes (legacy action; the MCP server now sends add_notes).

    Request format:
    {"action": "add_chord", "time": 0, "duration": 1.0,
     "notes": [{"midi": 60}, {"midi": 64, "offset": 0.5}, {"midi": 67, "duration": 2.0}]}
    """
    added = 0
    try:
        ppq = flp.score.PPQ
        current_time = int(ppq * request.get("time", 0))
        default_duration = request.get("duration", 1.0)
        for note_data in request.get("notes", []):
            midi_note = flp.Note()
            midi_note.number = note_data["midi"]
            midi_note.time = current_time + int(ppq * note_data.get("offset", 0))
            midi_note.length = int(ppq * note_data.get("duration", default_duration))
            midi_note.velocity = note_data.get("velocity", 0.8)
            _apply_note_properties(midi_note, note_data)
            flp.score.addNote(midi_note)
            added += 1
        return {"status": "success", "notes_added": added}
    except Exception as e:
        return {"status": "error", "message": str(e), "notes_added": added}


def delete_notes_from_piano_roll(request):
    """Delete notes matching (midi, time in quarter notes).

    Request format:
    {"action": "delete_notes", "notes": [{"midi": 60, "time": 0}]}
    """
    deleted = 0
    try:
        ppq = flp.score.PPQ
        criteria = [(n["midi"], int(ppq * n.get("time", 0))) for n in request.get("notes", [])]
        for i in range(flp.score.noteCount - 1, -1, -1):
            note = flp.score.getNote(i)
            if (note.number, note.time) in criteria:
                flp.score.deleteNote(i)
                deleted += 1
        return {"status": "success", "notes_deleted": deleted}
    except Exception as e:
        return {"status": "error", "message": str(e), "notes_deleted": deleted}


def add_notes_to_piano_roll(request):
    """Add notes; times and durations in quarter notes.

    Request format:
    {"action": "add_notes", "notes": [
        {"midi": 60, "time": 0, "duration": 1.0, "velocity": 0.8,
         "pan": 0.5, "color": 0, "slide": false, "porta": false}]}
    """
    added = 0
    try:
        ppq = flp.score.PPQ
        for note_data in request.get("notes", []):
            midi_note = flp.Note()
            midi_note.number = note_data["midi"]
            midi_note.time = int(ppq * note_data.get("time", note_data.get("offset", 0)))
            midi_note.length = int(ppq * note_data["duration"])
            midi_note.velocity = note_data.get("velocity", 0.8)
            _apply_note_properties(midi_note, note_data)
            flp.score.addNote(midi_note)
            added += 1
        return {"status": "success", "notes_added": added}
    except Exception as e:
        return {"status": "error", "message": str(e), "notes_added": added}


def apply(form=None):
    """
    AUTO MODE - Processes requests silently without dialog

    This script is designed to be triggered automatically via Ctrl+Alt+Y (Windows)
    or Cmd+Opt+Y (macOS).

    It processes pending requests and updates the state without showing any UI.
    """

    # Step 1: Process any pending requests
    result = process_mcp_request()

    # Step 2: Always export state AFTER processing
    # This ensures Claude sees the updated piano roll state
    try:
        export_piano_roll_state()
    except Exception as e:
        # Silent error handling - no UI shown
        pass

    # Step 3: Write result to response file
    if result:
        try:
            write_json(RESPONSE_FILE, result)
        except Exception:
            pass
